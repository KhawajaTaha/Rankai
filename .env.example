# --- Mode & brand ---
# "live" turns off every demo/mock fallback (nothing fake is generated or published).
# Leave empty for local demo mode with seeded sample data.
APP_MODE=""
NEXT_PUBLIC_BRAND_NAME="Top Tech Digital.AI"
# NEXT_PUBLIC_BRAND_LOGO="/brand/logo.png"

# --- Production (docker-compose.prod.yml) ---
DOMAIN=""                    # e.g. seo.toptechdigital.ai  (then APP_URL="https://seo.toptechdigital.ai")
POSTGRES_PASSWORD=""         # long random password for the bundled Postgres

# --- First admin for a live install: npm run setup:live ---
SETUP_ADMIN_EMAIL=""
SETUP_ADMIN_NAME=""
SETUP_ADMIN_PASSWORD=""      # min 10 characters
SETUP_ORG_NAME="Top Tech Digital.AI"
SETUP_TIMEZONE="Asia/Karachi"

# --- Core ---
DATABASE_URL="postgresql://rankai:rankai@localhost:5432/rankai"
APP_URL="http://localhost:3000"
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Session cookie secret (any long random string)
SESSION_SECRET=""
# Run the background job worker inside the Next.js server process (convenient for dev / single-node).
# For production run `npm run worker` as a separate process and set this to false.
RUN_WORKER_IN_PROCESS="true"

# --- AI (Claude). Required in live mode. Without a key (demo mode) AI runs in labelled mock mode. ---
# Cost: claude-haiku-5-5 is the cheapest ($0.10 / $0.50 per million tokens in/out) and fine for
# routine posts and replies; claude-opus-5-5 ($4 / $20) writes the best content.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
AI_EFFORT="medium"

# --- AI image generation (optional). Without a provider, brand-safe illustrative mock images are generated. ---
IMAGE_PROVIDER=""            # "openai" | "" (mock)
IMAGE_API_KEY=""
IMAGE_MODEL="gpt-image-1"

# --- Google (GBP, Search Console, GA4). Without credentials Google connections run in Demo mode. ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Rank tracking SERP provider (optional). Without it rankings use Demo data. ---
SERP_PROVIDER=""             # "dataforseo" | ""
SERP_API_LOGIN=""
SERP_API_PASSWORD=""

# --- Email (optional). Without SMTP, emails are written to the notification log. ---
SMTP_URL=""
# Free options: Brevo (smtp://LOGIN:KEY@smtp-relay.brevo.com:587) or Resend (smtps://resend:KEY@smtp.resend.com:465)
EMAIL_FROM="Top Tech Digital.AI <no-reply@example.com>"

# --- SMS / WhatsApp alerts via Twilio (optional). Without it, SMS/WhatsApp alerts are logged (Demo). ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""               # e.g. +18075550100
TWILIO_WHATSAPP_FROM=""      # optional WhatsApp-enabled sender

# --- Serverless job processing: POST /api/cron with Authorization: Bearer $CRON_SECRET ---
CRON_SECRET=""
