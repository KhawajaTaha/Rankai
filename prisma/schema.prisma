// AI Local SEO Autopilot — multi-tenant data model.
//
// Tenancy rules:
//  * Every tenant-owned row carries organizationId.
//  * Every client-scoped row also carries clientId (and locationId where a GBP location applies).
//  * All application reads/writes go through src/lib/tenancy.ts which injects these filters;
//    never query tenant tables without an organizationId predicate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum OrgUserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ClientStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  OFFBOARDING
  ARCHIVED
}

